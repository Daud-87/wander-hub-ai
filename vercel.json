{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "backend/**" }
  }
}
